{
  "manifest_version": 3,
  "name": "Ad Skimmer",
  "version": "1.0",
  "description": "Speed, mute and skip ads automatically",
  "permissions": [
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"]
    }
  ]
}